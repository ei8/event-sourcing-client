<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ei8.EventSourcing.Client</AssemblyName>
    <RootNamespace>ei8.EventSourcing.Client</RootNamespace>
    <PackageId>ei8.EventSourcing.Client</PackageId>
    <PackageVersion>0.3.9</PackageVersion>
    <Authors>Elmer Roderick Niem Bool</Authors>
    <Description>Event Sourcing Client</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Added InProcess EventStore.</PackageReleaseNotes>
    <PackageTags>event sourcing client</PackageTags>
    <Version>0.3.9</Version>
    <PackageLicenseUrl>https://www.apache.org/licenses/LICENSE-2.0</PackageLicenseUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\Release\netstandard2.0\ei8.EventSourcing.Client.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Http\**" />
    <EmbeddedResource Remove="Http\**" />
    <None Remove="Http\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ReflectionExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="ei8.EventSourcing.Common" Version="0.1.3" />
	  <PackageReference Include="ei8.EventSourcing.Port.Adapter.In.InProcess" Version="0.1.0" />
	  <PackageReference Include="ei8.EventSourcing.Port.Adapter.Out.InProcess" Version="0.1.0" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Neurul.Common" Version="0.2.1" />
    <PackageReference Include="neurUL.Common.CqrsLite" Version="0.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="11.0.1-beta1" />
    <PackageReference Include="sqlite-net-pcl" Version="1.7.335" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="NETStandard.Library" Version="2.0.1" />
  </ItemGroup>

</Project>
